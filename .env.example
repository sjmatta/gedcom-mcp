# GEDCOM MCP Server Configuration
# ================================

# Path to your GEDCOM file (required)
GEDCOM_FILE=/path/to/your/tree.ged

# Home person ID - the tree owner (optional, auto-detected if not set)
# GEDCOM_HOME_PERSON_ID=@I123@

# Anthropic API Key for the query tool's Strands Agent
ANTHROPIC_API_KEY=sk-ant-api03-...

# Query tool model configuration (optional)
# GEDCOM_QUERY_MODEL=claude-sonnet-4-20250514
# GEDCOM_QUERY_MAX_TOKENS=4096


# Tracing / Observability
# =======================

# Enable tracing (default: false)
PHOENIX_ENABLED=false

# Project name in tracing UI (default: gedcom-server)
PHOENIX_PROJECT_NAME=gedcom-server

# --- Arize Cloud (set both to use Arize) ---
# ARIZE_SPACE_ID=your-space-id
# ARIZE_API_KEY=your-api-key

# --- Local Phoenix (when Arize credentials are not set) ---
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006


# Semantic Search
# ===============

# Enable semantic/vector search for natural language queries (default: false)
# When enabled, builds embeddings for all individuals at startup
# First run: ~15-30s to build embeddings, subsequent runs load from cache
SEMANTIC_SEARCH_ENABLED=false

# Cache is automatically stored at {GEDCOM_FILE}.embeddings.npz
# Cache is invalidated when GEDCOM file changes (based on file hash)
